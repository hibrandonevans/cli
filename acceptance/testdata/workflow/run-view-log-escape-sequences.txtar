# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private

# Defer repo cleanup
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Clone the repo
exec gh repo clone $ORG/$SCRIPT_NAME-$RANDOM_STRING

# commit the workflow file
cd $SCRIPT_NAME-$RANDOM_STRING
mkdir .github/workflows
mv ../workflow.yml .github/workflows/workflow.yml
exec git add .github/workflows/workflow.yml
exec git commit -m 'Create workflow file'
exec git push -u origin main

# Sleep because it takes a second for the workflow to register
sleep 1

# Check the workflow is indeed created
exec gh workflow list
stdout 'Test Escape Sequences'

# Run the workflow
exec gh workflow run 'Test Escape Sequences'

# It takes some time for a workflow run to register
sleep 10

# Get the run ID we want to view
exec gh run list --json databaseId --jq '.[0].databaseId'
stdout2env RUN_ID

# Wait for workflow to complete
exec gh run watch $RUN_ID --exit-status

# View the log and verify escape sequences are stripped
exec gh run view $RUN_ID --log

# The raw ANSI codes should not appear in the output
! stdout '\x1b\['

-- workflow.yml --
name: Test Escape Sequences

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Output with escape sequences
        run: |
          printf '\033[32mThis is green text\033[0m\n'
          printf '\033]0;malicious title\007normal text\n'
          echo 'plain text'
